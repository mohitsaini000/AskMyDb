{
  "info": {
    "_postman_id": "askmydb-collection-0001",
    "name": "AskMyDb API",
    "description": "Test collection for the AskMyDb Spring AI project. Import this into Postman.\n\nFolders are in the same order the features were built:\n1. Diagnostics - basic wiring checks (Ollama, DB)\n2. Generate SQL only - see what the LLM produces without running it\n3. Ask (full pipeline) - question -> SQL -> guardrail -> execute -> real data\n\nRequires the app running on localhost:8080, Docker Postgres (pgvector) up, and Ollama running locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Diagnostics",
      "item": [
        {
          "name": "Hello AI (verify Ollama wiring)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/test-ai?message=Hello, who are you?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test-ai"
              ],
              "query": [
                {
                  "key": "message",
                  "value": "Hello, who are you?"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Generate SQL only (not executed)",
      "item": [
        {
          "name": "How many customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/generate-sql?question=How many customers do we have?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generate-sql"
              ],
              "query": [
                {
                  "key": "question",
                  "value": "How many customers do we have?"
                }
              ]
            }
          }
        },
        {
          "name": "Total revenue from delivered orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/generate-sql?question=What is the total revenue from delivered orders?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generate-sql"
              ],
              "query": [
                {
                  "key": "question",
                  "value": "What is the total revenue from delivered orders?"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ask (full pipeline)",
      "item": [
        {
          "name": "How many customers do we have?",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many customers do we have?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            }
          }
        },
        {
          "name": "Total revenue from delivered orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the total revenue from delivered orders?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            }
          }
        },
        {
          "name": "Which city has the most customers?",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Which city has the most customers?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            }
          }
        },
        {
          "name": "Validation failure - empty question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            }
          }
        },
        {
          "name": "Guardrail test - destructive request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Delete all customers\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Auth",
      "item": [
        {
          "name": "Register - new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mohit\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register - validation failure (short password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mohit\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register - username already taken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mohit\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - success (get JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mohit\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded and returned both tokens\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mohit\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - username does not exist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"no_such_user\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Refresh - get new access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh returned a new token pair\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "    // Rotation: the OLD refreshToken is now revoked - always overwrite",
                  "    // the stored one with this new one, or the next refresh will fail.",
                  "    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - reused (already-rotated) token fails",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"paste-an-already-used-refresh-token-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Logout - revoke refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logout succeeded (204)\", function () {",
                  "    pm.response.to.have.status(204);",
                  "    pm.collectionVariables.set(\"refreshToken\", \"\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  }
}
